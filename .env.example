# ==============================================================================
# FlowMind AI — Template de Variáveis de Ambiente (.env.example)
# NOTA: Não versione arquivos .env com valores reais contendo credenciais ou chaves.
# ==============================================================================

# Configurações do Servidor e Aplicação
NODE_ENV=development
PORT=3001
WEB_APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001

# Banco de Dados (PostgreSQL via Docker Compose)
DATABASE_URL="postgresql://flowmind_user:flowmind_password@localhost:5432/flowmind_dev?schema=public"

# Fila de Mensagens e Cache (Redis via Docker Compose)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Autenticação e Multi-tenant (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# Inteligência Artificial (OpenAI API)
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"

# Segurança e Criptografia Interna (32 bytes hex)
ENCRYPTION_KEY_32BYTES="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
